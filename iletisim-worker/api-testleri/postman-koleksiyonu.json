{
  "info": {
    "_postman_id": "d84c92a0-7b1e-4f5a-9c3d-2e8a1b4f6005",
    "name": "helyosfer.me — İletişim Worker'ı API ve Sınır Değer Test Koleksiyonu",
    "description": "Hizmetler sayfası sohbet penceresi (/v1/*) ve yönetim paneli (/admin/api/*) uç noktaları için fonksiyonel, sınır değer, negatif ve güvenlik test koleksiyonu. Newman ile CI/CD'de doğrudan çalıştırılabilir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8787" },
    { "key": "izinliKoken", "value": "http://127.0.0.1:5500" },
    { "key": "sohbetId", "value": "00000000-0000-4000-8000-000000000000" },
    { "key": "belirtec", "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" },
    { "key": "sonMesajId", "value": "0" }
  ],
  "item": [
    {
      "name": "1. Ziyaretçi API — Fonksiyonel Akış",
      "item": [
        {
          "name": "01. OPTIONS /v1/mesaj — İzinli Köken (204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('CORS başlıkları doğru', () => {",
                  "  pm.expect(pm.response.headers.get('access-control-allow-origin')).to.eql(pm.collectionVariables.get('izinliKoken'));",
                  "  pm.expect(pm.response.headers.get('access-control-allow-methods')).to.include('POST');",
                  "  pm.expect(pm.response.headers.get('vary')).to.eql('Origin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "{{izinliKoken}}" },
              { "key": "Access-Control-Request-Method", "value": "POST" },
              { "key": "Access-Control-Request-Headers", "value": "content-type, authorization" }
            ],
            "url": "{{baseUrl}}/v1/mesaj"
          }
        },
        {
          "name": "02. POST /v1/mesaj — Yeni Sohbet Açma (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Güvenlik başlıkları mevcut', () => {",
                  "  pm.expect(pm.response.headers.get('x-content-type-options')).to.eql('nosniff');",
                  "  pm.expect(pm.response.headers.get('cache-control')).to.eql('no-store');",
                  "});",
                  "const g = pm.response.json();",
                  "pm.test('Sohbet UUID, 43 krk base64url belirteç ve asistan cevabı döndü', () => {",
                  "  pm.expect(g.sohbet).to.match(/^[0-9a-f-]{36}$/i);",
                  "  pm.expect(g.belirtec).to.match(/^[A-Za-z0-9_-]{43}$/);",
                  "  pm.expect(g.asistan).to.eql(true);",
                  "  pm.expect(g.mesajlar).to.be.an('array').with.lengthOf(2);",
                  "  pm.expect(g.mesajlar[0].gonderen).to.eql('ziyaretci');",
                  "  pm.expect(g.mesajlar[1].gonderen).to.eql('asistan');",
                  "});",
                  "pm.collectionVariables.set('sohbetId', g.sohbet);",
                  "pm.collectionVariables.set('belirtec', g.belirtec);",
                  "pm.collectionVariables.set('sonMesajId', String(g.mesajlar[1].id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Origin", "value": "{{izinliKoken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"metin\":\"Merhaba, Windows yanına Linux Mint dual boot kurulumu yapılabilir mi?\",\"ad\":\"Deniz Yılmaz\",\"iletisim\":\"deniz.yilmaz@ornek.test\",\"dil\":\"tr\"}"
            },
            "url": "{{baseUrl}}/v1/mesaj"
          }
        },
        {
          "name": "03. POST /v1/mesaj — Mevcut Sohbete Mesaj Ekleme (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 200 OK', () => pm.response.to.have.status(200));",
                  "const g = pm.response.json();",
                  "pm.test('Aynı sohbet ID korundu ve yeni belirteç dönmedi', () => {",
                  "  pm.expect(g.sohbet).to.eql(pm.collectionVariables.get('sohbetId'));",
                  "  pm.expect(g).to.not.have.property('belirtec');",
                  "  pm.expect(g.mesajlar).to.have.lengthOf(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Origin", "value": "{{izinliKoken}}" },
              { "key": "Authorization", "value": "Bearer {{sohbetId}}.{{belirtec}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"metin\":\"Diskte 250 GB boş alan var, uzaktan bağlantı ile kurulabilir mi?\",\"dil\":\"tr\"}"
            },
            "url": "{{baseUrl}}/v1/mesaj"
          }
        },
        {
          "name": "04. GET /v1/mesaj — Tüm Sohbet Geçmişini Okuma (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 200 OK', () => pm.response.to.have.status(200));",
                  "const g = pm.response.json();",
                  "pm.test('Sohbet durumu açık ve 4 mesaj mevcut', () => {",
                  "  pm.expect(g.durum).to.eql('acik');",
                  "  pm.expect(g.asistan).to.eql(true);",
                  "  pm.expect(g.mesajlar).to.have.lengthOf(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Origin", "value": "{{izinliKoken}}" },
              { "key": "Authorization", "value": "Bearer {{sohbetId}}.{{belirtec}}" }
            ],
            "url": "{{baseUrl}}/v1/mesaj"
          }
        },
        {
          "name": "05. GET /v1/mesaj?sonra= — Artımlı Yoklama (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 200 OK', () => pm.response.to.have.status(200));",
                  "const g = pm.response.json();",
                  "const esik = Number(pm.collectionVariables.get('sonMesajId'));",
                  "pm.test('Yalnızca sonMesajId değerinden büyük mesajlar döndü', () => {",
                  "  pm.expect(g.mesajlar).to.have.lengthOf(2);",
                  "  g.mesajlar.forEach((m) => pm.expect(m.id).to.be.above(esik));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Origin", "value": "{{izinliKoken}}" },
              { "key": "Authorization", "value": "Bearer {{sohbetId}}.{{belirtec}}" }
            ],
            "url": "{{baseUrl}}/v1/mesaj?sonra={{sonMesajId}}"
          }
        },
        {
          "name": "06. POST /v1/devret — Sohbeti İnsana Devretme (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 200 OK', () => pm.response.to.have.status(200));",
                  "const g = pm.response.json();",
                  "pm.test('Asistan kapatıldı ve devir mesajı eklendi', () => {",
                  "  pm.expect(g.asistan).to.eql(false);",
                  "  pm.expect(g.mesajlar).to.have.lengthOf(5);",
                  "  pm.expect(g.mesajlar[4].gonderen).to.eql('asistan');",
                  "  pm.expect(g.mesajlar[4].metin).to.include('Helyosfer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Origin", "value": "{{izinliKoken}}" },
              { "key": "Authorization", "value": "Bearer {{sohbetId}}.{{belirtec}}" }
            ],
            "url": "{{baseUrl}}/v1/devret"
          }
        }
      ]
    },
