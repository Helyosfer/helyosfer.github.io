{
  "name": "helyosfer-erisilebilirlik",
  "private": true,
  "description": "Site için erişilebilirlik ve duyarlılık denetimi: Playwright + axe, Pa11y, Lighthouse CI",
  "type": "module",
  "scripts": {
    "test": "playwright test -c playwright.config.mjs",
    "pa11y": "pa11y-ci --config .pa11yci.json",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "lighthouse:masaustu": "lhci autorun --config=lighthouserc.json --collect.settings.preset=desktop"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "pa11y-ci": "4.1.1"
  }
}
